# Get your API key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_api_key_here

# ── Authentication (optional) ────────────────────────────────────────────
# Firebase Auth powers email/password + Google sign-in. Without these keys the
# app falls back to on-device accounts (PBKDF2-hashed, this browser only) and
# the Google button explains that configuration is needed.
# Console → Project settings → Your apps → Web app config.
# Also enable Authentication → Sign-in method → Email/Password and Google,
# and add your dev/prod domains under Authentication → Settings → Authorised domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
